# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only these emails can sign in (comma-separated). Fails closed if empty.
ALLOWED_EMAILS=you@example.com

# Public URL used in magic-link redirects (e.g. https://ledger-yourname.vercel.app).
# Optional locally; falls back to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts the SimpleFIN access URL at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Vercel Cron sends this as a Bearer token to /api/cron/sync.
#   openssl rand -hex 24
CRON_SECRET=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional context for the AI (categorizer + chat), e.g. "Cyclist in Colorado; runs a small software LLC"
FINANCE_USER_CONTEXT=
